FROM python:3.11-slim

WORKDIR /app

# Install build dependencies for tree-sitter C extensions if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY mcp_server/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY mcp_server /app/mcp_server

ENV PYTHONPATH=/app
ENV STORAGE_BASE=/data/nexsolve/projects

# Default stdio execution for FastMCP
ENTRYPOINT ["python", "-m", "mcp_server.server"]
