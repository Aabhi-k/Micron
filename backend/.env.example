# Application Configuration
APP_NAME=Micron
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# OpenRouter / LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MCP & Storage Security Configuration
STORAGE_PROJECTS_ROOT=storage/projects
MAX_FILE_SIZE_BYTES=1048576
MCP_SERVER_NAME=legacy-code-security-server

# Observability (Langfuse Cloud)
# Get keys at: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU Region: https://cloud.langfuse.com | US Region: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com


