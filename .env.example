# ==============================================================================
# Micron Environment Configuration Template
# ==============================================================================

# General
APP_NAME=Micron
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Mounts
STORAGE_BASE=./storage/projects
VECTOR_STORE_DIR=./vector_store

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/micron

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MCP Server
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m mcp_server.server

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=business_documents

# Cache & Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_INSIGHT_PORT=5540

# Embeddings & Search
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FALLBACK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RRF_K=60

# Observability (Langfuse - Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend
VITE_API_BASE_URL=http://localhost:8000
